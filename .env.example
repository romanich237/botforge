PORT=3000
PUBLIC_ORIGIN=https://example.com
ALLOWED_ORIGINS=https://example.com
DATA_DIR=/root/botforge/shared/data

# AI provider
AI_API_KEY=
AI_BASE_URL=https://triklz27.ru/v1
AI_MODEL=minimax-m3.1-flash
AI_FALLBACK_MODELS=mimo-v2.6-flash,glm-5.3-flash
AI_DAILY_LIMIT=5
AI_GLOBAL_DAILY_LIMIT=100
AI_STARTING_CREDITS=20

# Google OAuth 2.0 (optional; enables the Google sign-in button when both values are set).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OWNER_SUB=
# Email/password sign-in remains available as a fallback.
# Keep PUBLIC_ORIGIN set to your HTTPS domain in production.

